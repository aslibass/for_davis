# Ayurvedic Retreat Aggregation Platform — Environment Variables

# BACKEND — Core
JWT_SECRET=your-long-random-secret-here-min-32-chars
PORT=8000                              # Railway sets automatically; local dev can override
DATABASE_URL=                          # Leave blank for SQLite (local dev); set for Railway Postgres

# BACKEND — Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# FRONTEND — Stripe (Client-side)
VITE_STRIPE_PK=pk_test_...

# FRONTEND — API
VITE_API_URL=http://localhost:8000     # Local dev; set to https://api.yourdomain.com on Railway

# CORS — Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173  # Local dev; set to exact frontend URL on Railway (with https://)

# Email — Transactional (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=bookings@yourdomain.com

# Optional — Future use
# DATABASE_URL=postgresql://user:pass@host/dbname  # For Railway Postgres migration
# NODE_ENV=production                  # Set by Railway automatically
